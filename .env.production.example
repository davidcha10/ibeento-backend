# Core
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# Web app URLs
WEB_APP_URL=https://www.ibeento.com
WEB_APP_URL_PROD=https://www.ibeento.com
WEB_APP_URL_DEV=http://localhost:4200
COOKIE_DOMAIN=.ibeento.com
CORS_ALLOWED_ORIGINS=https://www.ibeento.com,https://ibeento.com,https://ibeento.vercel.app

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
ACCESS_TOKEN_TTL_SEC=7200
REFRESH_TOKEN_TTL_DAYS=30
ITINERARY_INVITE_LINK_TTL_DAYS=30

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_WEEKLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_PRICE_ID_TRIAL=price_...

# External providers
GOOGLE_PLACES_API_KEY=...
GEMINI_API_KEY=...
GEMINI_MODEL_ID=
GEMINI_FALLBACK_MODEL_IDS=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_LOGO_URL=

# Optional AI tuning
AI_EXECUTION_ENABLED=true
AI_MIN_ACTIVITIES_PER_DAY=
AI_MIN_OCCUPIED_MINUTES_PER_DAY=
AI_SELECTED_ACTIVITIES_CAP=

# Optional admin allow list (comma-separated emails)
ADMIN_ALLOWED_EMAILS=
